{
  "manifest_version": 3,
  "name": "ChatGPT Anthropic Typography",
  "version": "3.0.0",
  "description": "Switch ChatGPT between Anthropic Serif and Sans typography, with optional Anthropic-inspired colors.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ChatGPT Anthropic Typography",
    "default_popup": "popup.html"
  }
}
